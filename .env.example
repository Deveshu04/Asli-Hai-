BOLNA_API_KEY=
TOOL_SECRET=
PUBLIC_BASE_URL=https://your-tunnel.example.com

AGENT_ID_PARENT_SARVAM=
AGENT_ID_CHECK_SARVAM=
AGENT_ID_PARENT_COMPARE=
AGENT_ID_CHECK_COMPARE=

VOICE_STACK=sarvam
VERDICT_TIMEOUT_S=75
# Calls the first family contact alongside the parent; needs Bolna concurrency of 2. Set to off for one call at a time.
RESCUE_CALLS=on
# Optional key for hashing family words; defaults to TOOL_SECRET. Set it before ever rotating TOOL_SECRET.
WORD_KEY=
DB_PATH=asli.db
# Optional: a number on your Bolna account to call from; blank uses the account default.
BOLNA_FROM_NUMBER=
# Optional: require this code on the signup page.
SIGNUP_CODE=
# Family summary on WhatsApp: a Bolna workflow whose AiSensy node sends an approved template.
# The AiSensy project API key and project ID are linked in the Bolna dashboard (Integrations), not here.
AISENSY_TEMPLATE_NAME=
AISENSY_CAMPAIGN_NAME=
AISENSY_TEMPLATE_LANGUAGE=en
# Printed by scripts/summary_workflow.py --publish. Blank: no summary is sent and a warning is logged.
SUMMARY_WORKFLOW_ID=
