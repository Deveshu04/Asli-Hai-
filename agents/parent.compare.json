{
  "agent_config": {
    "agent_name": "Asli hai? Parent line (Compare)",
    "agent_type": "other",
    "agent_welcome_message": "{{greeting}}",
    "webhook_url": "https://YOUR-BACKEND/webhooks/bolna",
    "tasks": [
      {
        "task_type": "conversation",
        "toolchain": {
          "execution": "parallel",
          "pipelines": [
            [
              "transcriber",
              "llm",
              "synthesizer"
            ]
          ]
        },
        "task_config": {
          "hangup_after_LLMCall": false,
          "call_terminate": 300,
          "check_if_user_online": false,
          "hangup_after_silence": 120,
          "incremental_delay": 2000,
          "number_of_words_for_interruption": 3
        },
        "tools_config": {
          "input": {
            "format": "wav",
            "provider": "plivo"
          },
          "output": {
            "format": "wav",
            "provider": "plivo"
          },
          "api_tools": {
            "tools": [
              {
                "key": "custom_task",
                "name": "start_verification",
                "description": "Start calling the parent's registered family member to check the claim.",
                "parameters": {
                  "type": "object",
                  "required": [
                    "session_id"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string"
                    },
                    "claimed_name": {
                      "type": "string",
                      "description": "Name or relation the caller used"
                    },
                    "amount_asked": {
                      "type": "number"
                    },
                    "story": {
                      "type": "string"
                    }
                  }
                },
                "pre_call_message": "मैं अभी आपके परिवार को कॉल कर रही हूँ। लाइन पर बने रहिए।"
              },
              {
                "key": "custom_task",
                "name": "alert_family",
                "description": "Tell the parent's family that they just got a scam call.",
                "parameters": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "claim"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string"
                    },
                    "claim": {
                      "type": "string",
                      "description": "authority if the caller claimed to be police or an official, paid if money or an OTP already went"
                    }
                  }
                }
              },
              {
                "key": "custom_task",
                "name": "retry_family",
                "description": "Call the parent's family again after an earlier check could not confirm the claim.",
                "parameters": {
                  "type": "object",
                  "required": [
                    "session_id"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string"
                    }
                  }
                },
                "pre_call_message": "मैं अभी आपके परिवार को कॉल कर रही हूँ। लाइन पर बने रहिए।"
              }
            ],
            "tools_params": {
              "start_verification": {
                "url": "https://YOUR-BACKEND/tools/start_verification",
                "method": "POST",
                "param": {
                  "session_id": "%(session_id)s",
                  "claimed_name": "%(claimed_name)s",
                  "amount_asked": "%(amount_asked)s",
                  "story": "%(story)s"
                },
                "headers": {
                  "Authorization": "Bearer YOUR_TOOL_SECRET",
                  "Content-Type": "application/json"
                },
                "scope": "node",
                "nodes": [
                  "verifying"
                ]
              },
              "alert_family": {
                "url": "https://YOUR-BACKEND/tools/alert_family",
                "method": "POST",
                "param": {
                  "session_id": "%(session_id)s",
                  "claim": "%(claim)s"
                },
                "headers": {
                  "Authorization": "Bearer YOUR_TOOL_SECRET",
                  "Content-Type": "application/json"
                },
                "scope": "node",
                "nodes": [
                  "alert_authority",
                  "alert_paid"
                ]
              },
              "retry_family": {
                "url": "https://YOUR-BACKEND/tools/retry_family",
                "method": "POST",
                "param": {
                  "session_id": "%(session_id)s"
                },
                "headers": {
                  "Authorization": "Bearer YOUR_TOOL_SECRET",
                  "Content-Type": "application/json"
                },
                "scope": "node",
                "nodes": [
                  "retrying"
                ]
              }
            }
          },
          "llm_agent": {
            "agent_type": "graph_agent",
            "agent_flow_type": "streaming",
            "llm_config": {
              "provider": "openai",
              "model": "gpt-5.4-mini",
              "temperature": 1,
              "max_tokens": 150,
              "routing_model": "gpt-4.1-mini",
              "routing_max_tokens": 250,
              "routing_instructions": "Pick the edge that matches what the parent said. If the parent mentions any family member or relative (son, daughter, beta, a name), choose the family edge even if police or officials were also mentioned. If unsure, stay on the current node.",
              "agent_information": "You are Saathi on the 'Asli hai?' safety line, speaking to {{parent_name}}, an older person who may be scared. Reply in the language of the call, in its own script, in one or two short, warm sentences, and ask at most one question at a time. Listen first: respond to what they actually said and use the details they gave, such as who called and how much was asked. Rules you never break: never tell them to send money. Never call a claim genuine unless you are on verdict_real. Never ask for or repeat an OTP, PIN, password, card or account number, or the family word. Never promise that money can be recovered or refunded. Never say you are the police, a bank or a government officer. Give no legal advice beyond this: police and agencies never arrest or question anyone on a phone or video call, and there is no 'digital arrest' in the law. Never tell them to argue with the caller, and never blame them. Stay on this call and on keeping them safe from the scam; if they ask about anything else, gently say you can only help with this right now.",
              "current_node_id": "listen",
              "nodes": [
                {
                  "id": "listen",
                  "prompt": "Let {{parent_name}} tell you what happened in their own words. Each time, first acknowledge what they just said in a few words, repeating a key detail such as the name or the amount, then ask one short question about something still missing: who the caller claimed to be, what they asked for (money, an OTP, staying on a video call), how much, and whether anything was already sent. If their sentence sounds unfinished, only say a short 'haan ji, boliye' in the call's language and let them go on.",
                  "edges": [
                    {
                      "to_node_id": "already_paid",
                      "condition": "The parent already sent money, shared an OTP, or gave bank details",
                      "parameters": {
                        "paid_amount": "number"
                      }
                    },
                    {
                      "to_node_id": "authority_scam",
                      "condition": "The caller claimed only to be police, CBI, ED, a court, TRAI, customs, a courier or a bank officer, and the parent did not mention any family member",
                      "parameters": {
                        "claimed_authority": {
                          "type": "string",
                          "allowed_values": [
                            "police",
                            "cbi",
                            "ed",
                            "court",
                            "trai",
                            "customs",
                            "courier",
                            "bank",
                            "other"
                          ]
                        }
                      }
                    },
                    {
                      "to_node_id": "verifying",
                      "condition": "The caller claimed to be, or the parent mentions, a family member or friend (son, daughter, grandchild, relative or a name) who needs money or help, even if police, a hospital or an official was also mentioned",
                      "parameters": {
                        "claimed_name": {
                          "type": "string",
                          "description": "The name or relation the caller used, e.g. Rahul, beta, bhanja"
                        },
                        "amount_asked": "number",
                        "story": {
                          "type": "string",
                          "description": "One line: the emergency they described"
                        }
                      }
                    },
                    {
                      "to_node_id": "verifying",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_node_turns",
                            "operator": "gte",
                            "value": 5
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "id": "verifying",
                  "prompt": "Call @start_verification now with session_id {{session_id}} and the details you collected.",
                  "function_call": "start_verification",
                  "edges": [
                    {
                      "to_node_id": "verdict_fake",
                      "condition_type": "event",
                      "event_name": "child_safe"
                    },
                    {
                      "to_node_id": "verdict_real",
                      "condition_type": "event",
                      "event_name": "child_confirmed"
                    },
                    {
                      "to_node_id": "verdict_unconfirmed",
                      "condition_type": "event",
                      "event_name": "not_confirmed"
                    },
                    {
                      "to_node_id": "holding",
                      "condition_type": "unconditional"
                    }
                  ]
                },
                {
                  "id": "holding",
                  "prompt": "You are waiting for the family member to pick up. Reassure in one sentence. Tell the parent not to answer or call back the other number. Never guess the result.",
                  "repeat_after_silence_seconds": 15,
                  "edges": [
                    {
                      "to_node_id": "verdict_fake",
                      "condition_type": "event",
                      "event_name": "child_safe"
                    },
                    {
                      "to_node_id": "verdict_real",
                      "condition_type": "event",
                      "event_name": "child_confirmed"
                    },
                    {
                      "to_node_id": "verdict_unconfirmed",
                      "condition_type": "event",
                      "event_name": "not_confirmed"
                    },
                    {
                      "to_node_id": "verdict_unconfirmed",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_silence_repeats",
                            "operator": "gte",
                            "value": 6
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "id": "verdict_fake",
                  "node_type": "static",
                  "static_message": "अच्छी ख़बर। मैंने आपके परिवार से बात कर ली है। वो बिल्कुल ठीक हैं और उन्होंने आपको कोई कॉल नहीं किया। वो कॉल नकली था। कोई पैसा या OTP मत दीजिए, और उस नंबर को ब्लॉक कर दीजिए।",
                  "edges": [
                    {
                      "to_node_id": "aftercare",
                      "condition_type": "unconditional"
                    }
                  ],
                  "number_of_words_for_interruption": 0
                },
                {
                  "id": "verdict_real",
                  "prompt": "{{verified_name}} confirmed the call and gave the family word. Say it is genuine. Advise paying only to an account {{verified_name}} gives directly, after calling them back on their saved number.",
                  "edges": [
                    {
                      "to_node_id": "aftercare",
                      "condition_type": "unconditional"
                    }
                  ]
                },
                {
                  "id": "verdict_unconfirmed",
                  "node_type": "static",
                  "static_message": "अभी मैं आपके परिवार से पक्की बात नहीं कर पाई। जब तक आप ख़ुद उनसे उनके पुराने नंबर पर बात न कर लें, कोई पैसा मत भेजिए। असली मुसीबत होगी तो वो थोड़ा इंतज़ार कर सकती है।",
                  "edges": [
                    {
                      "to_node_id": "aftercare",
                      "condition_type": "unconditional"
                    }
                  ],
                  "number_of_words_for_interruption": 0
                },
                {
                  "id": "authority_scam",
                  "node_type": "static",
                  "static_message": "ध्यान से सुनिए। डिजिटल अरेस्ट नाम की कोई चीज़ क़ानून में नहीं है। पुलिस, CBI या कोर्ट वीडियो कॉल पर पैसे नहीं माँगते। अभी वो कॉल काट दीजिए, और कोई OTP या पैसा मत दीजिए। मैं आपके परिवार को बता रही हूँ।",
                  "edges": [
                    {
                      "to_node_id": "alert_authority",
                      "condition_type": "unconditional"
                    }
                  ],
                  "number_of_words_for_interruption": 0
                },
                {
                  "id": "already_paid",
                  "node_type": "static",
                  "static_message": "घबराइए मत, पर अभी तुरंत 1930 पर कॉल कीजिए, शुरू के घंटे सबसे ज़रूरी होते हैं। फिर अपने बैंक को भी कॉल कीजिए। मैं आपके परिवार को अभी ख़बर कर रही हूँ।",
                  "edges": [
                    {
                      "to_node_id": "alert_paid",
                      "condition_type": "unconditional"
                    }
                  ],
                  "number_of_words_for_interruption": 0
                },
                {
                  "id": "alert_authority",
                  "prompt": "Call @alert_family now with session_id {{session_id}} and claim authority. Then reassure the parent in one short sentence that the family is being told.",
                  "function_call": "alert_family",
                  "edges": [
                    {
                      "to_node_id": "aftercare",
                      "condition_type": "unconditional"
                    }
                  ]
                },
                {
                  "id": "alert_paid",
                  "prompt": "Call @alert_family now with session_id {{session_id}} and claim paid. Then reassure the parent in one short sentence that the family is being told.",
                  "function_call": "alert_family",
                  "edges": [
                    {
                      "to_node_id": "aftercare",
                      "condition_type": "unconditional"
                    }
                  ]
                },
                {
                  "id": "aftercare",
                  "prompt": "The safety message has been given. Now talk with {{parent_name}} like a calm, caring person. Answer exactly what they asked or said, in one or two short sentences, using what you know: the caller claimed to be {{claimed_name}} and asked for {{amount_asked}} (a value shown as NULL is unknown). Never repeat advice you already gave. If money or an OTP already went, tell them to call 1930 right now. If they ask you to call their family again, say you will. When they seem settled, ask whether there is anything else.",
                  "edges": [
                    {
                      "to_node_id": "closing",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_silence_repeats",
                            "operator": "gte",
                            "value": 2
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "closing",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_node_turns",
                            "operator": "gte",
                            "value": 8
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "retrying",
                      "condition": "The parent asks Saathi to call, try or check with their family again"
                    },
                    {
                      "to_node_id": "closing",
                      "condition": "Saathi asked whether they need anything else and the parent said no, or the parent says goodbye or that they are done"
                    }
                  ],
                  "repeat_after_silence_seconds": 12
                },
                {
                  "id": "retrying",
                  "prompt": "Call @retry_family now with session_id {{session_id}}.",
                  "function_call": "retry_family",
                  "edges": [
                    {
                      "to_node_id": "verdict_fake",
                      "condition_type": "event",
                      "event_name": "child_safe"
                    },
                    {
                      "to_node_id": "verdict_real",
                      "condition_type": "event",
                      "event_name": "child_confirmed"
                    },
                    {
                      "to_node_id": "verdict_unconfirmed",
                      "condition_type": "event",
                      "event_name": "not_confirmed"
                    },
                    {
                      "to_node_id": "holding",
                      "condition_type": "unconditional"
                    }
                  ]
                },
                {
                  "id": "closing",
                  "node_type": "static",
                  "static_message": "अपना ध्यान रखिए। जब भी शक हो, यही बटन दबाइए। नमस्ते।",
                  "function_call": "end_call",
                  "edges": []
                }
              ],
              "reasoning_effort": "none"
            }
          },
          "transcriber": {
            "provider": "deepgram",
            "model": "nova-3",
            "language": "multi-hi",
            "stream": true,
            "endpointing": 1200
          },
          "synthesizer": {
            "provider": "cartesia",
            "stream": true,
            "provider_config": {
              "model": "sonic-3.6",
              "voice": "Kavita - Customer Care Agent",
              "voice_id": "56e35e2d-6eb6-4226-ab8b-9776515a7094",
              "language": "hi"
            }
          }
        }
      }
    ]
  },
  "agent_prompts": {
    "task_1": {
      "system_prompt": "You are Saathi on the 'Asli hai?' safety line, speaking to {{parent_name}}, an older parent. Reply in the language of the call, in its own script, in one or two short simple sentences. Never tell them to send money. Never call a claim genuine unless you are on verdict_real. Never ask for an OTP, PIN or account number."
    }
  }
}
