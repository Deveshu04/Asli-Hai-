{
  "agent_config": {
    "agent_name": "Asli hai? Family check (Sarvam)",
    "agent_type": "other",
    "agent_welcome_message": "{{greeting}}",
    "webhook_url": "https://YOUR-BACKEND/webhooks/bolna",
    "tasks": [
      {
        "task_type": "conversation",
        "toolchain": {
          "execution": "parallel",
          "pipelines": [
            [
              "transcriber",
              "llm",
              "synthesizer"
            ]
          ]
        },
        "task_config": {
          "hangup_after_LLMCall": false,
          "call_terminate": 120,
          "voicemail": true,
          "check_if_user_online": false,
          "incremental_delay": 1000,
          "number_of_words_for_interruption": 2
        },
        "tools_config": {
          "input": {
            "format": "wav",
            "provider": "plivo"
          },
          "output": {
            "format": "wav",
            "provider": "plivo"
          },
          "api_tools": {
            "tools": [
              {
                "key": "custom_task",
                "name": "report_verdict",
                "description": "Send the family member's answer to the safety line.",
                "parameters": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "did_call"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string"
                    },
                    "did_call": {
                      "type": "string"
                    },
                    "spoken_word": {
                      "type": "string"
                    }
                  }
                }
              }
            ],
            "tools_params": {
              "report_verdict": {
                "url": "https://YOUR-BACKEND/tools/report_verdict",
                "method": "POST",
                "param": {
                  "session_id": "%(session_id)s",
                  "did_call": "%(did_call)s",
                  "spoken_word": "%(spoken_word)s"
                },
                "headers": {
                  "Authorization": "Bearer YOUR_TOOL_SECRET",
                  "Content-Type": "application/json"
                },
                "scope": "node",
                "nodes": [
                  "report"
                ]
              }
            }
          },
          "llm_agent": {
            "agent_type": "graph_agent",
            "agent_flow_type": "streaming",
            "llm_config": {
              "provider": "openai",
              "model": "gpt-5.4-mini",
              "temperature": 1,
              "max_tokens": 120,
              "routing_model": "gpt-4.1-mini",
              "agent_information": "You are Saathi from the 'Asli hai?' safety line, calling {{child_name}} about a call their parent {{parent_name}} just got. Speak the language of the call, in its own script, one short sentence at a time. Never reveal the family word or the parent's number. If someone other than {{child_name}} answers, ask them to have {{child_name}} call their parent now.",
              "current_node_id": "ask_called",
              "nodes": [
                {
                  "id": "ask_called",
                  "prompt": "Get a clear yes or no: did they just call {{parent_name}} asking for money or help? Repeat the question once if they are confused.",
                  "repeat_after_silence_seconds": 8,
                  "edges": [
                    {
                      "to_node_id": "alert_done",
                      "condition_type": "expression",
                      "priority": 0,
                      "expression": {
                        "conditions": [
                          {
                            "variable": "recipient_data.mode",
                            "operator": "eq",
                            "value": "alert"
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "route_called",
                      "condition": "The person answered whether they called",
                      "parameters": {
                        "did_call": {
                          "type": "string",
                          "description": "Yes if they called the parent and asked for money or help. No if they did not. Unsure if unclear or someone else answered.",
                          "allowed_values": [
                            "Yes",
                            "No",
                            "Unsure"
                          ]
                        }
                      }
                    },
                    {
                      "to_node_id": "report",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_silence_repeats",
                            "operator": "gte",
                            "value": 2
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "id": "route_called",
                  "node_type": "router",
                  "edges": [
                    {
                      "to_node_id": "report",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "did_call",
                            "operator": "eq",
                            "value": "No"
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "ask_word",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "did_call",
                            "operator": "eq",
                            "value": "Yes"
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "report",
                      "condition_type": "unconditional"
                    }
                  ]
                },
                {
                  "id": "ask_word",
                  "prompt": "Ask them to say the family word. Never say or hint at the word yourself.",
                  "edges": [
                    {
                      "to_node_id": "report",
                      "condition": "They said a word or phrase, or said they don't know it",
                      "parameters": {
                        "spoken_word": "string"
                      }
                    }
                  ]
                },
                {
                  "id": "report",
                  "prompt": "Call @report_verdict with session_id {{session_id}}, did_call and spoken_word.",
                  "function_call": "report_verdict",
                  "edges": [
                    {
                      "to_node_id": "thanks",
                      "condition_type": "unconditional"
                    }
                  ]
                },
                {
                  "id": "thanks",
                  "node_type": "static",
                  "static_message": {
                    "hi": "शुक्रिया। मैं उन्हें अभी बता रही हूँ। नमस्ते।",
                    "en": "Thank you. I'm letting them know right now. Namaste.",
                    "bn": "ধন্যবাদ। আমি এখনই ওনাকে জানাচ্ছি। নমস্কার।",
                    "mr": "धन्यवाद. मी त्यांना आत्ताच सांगते. नमस्कार.",
                    "te": "ధన్యవాదాలు. నేను ఇప్పుడే వారికి చెబుతున్నాను. నమస్తే.",
                    "ta": "நன்றி. நான் இப்போதே அவர்களிடம் சொல்கிறேன். வணக்கம்.",
                    "gu": "આભાર. હું તેમને હમણાં જ જણાવું છું. નમસ્તે.",
                    "kn": "ಧನ್ಯವಾದಗಳು. ನಾನು ಈಗಲೇ ಅವರಿಗೆ ತಿಳಿಸುತ್ತಿದ್ದೇನೆ. ನಮಸ್ಕಾರ.",
                    "ml": "നന്ദി. ഞാൻ ഇപ്പോൾ തന്നെ അവരെ അറിയിക്കുന്നു. നമസ്കാരം.",
                    "pa": "ਧੰਨਵਾਦ। ਮੈਂ ਉਨ੍ਹਾਂ ਨੂੰ ਹੁਣੇ ਦੱਸ ਰਹੀ ਹਾਂ। ਸਤ ਸ੍ਰੀ ਅਕਾਲ।",
                    "od": "ଧନ୍ୟବାଦ। ମୁଁ ଏବେ ତାଙ୍କୁ ଜଣାଉଛି। ନମସ୍କାର।",
                    "as": "ধন্যবাদ। মই এতিয়াই তেওঁক জনাই আছোঁ। নমস্কাৰ।"
                  },
                  "function_call": "end_call",
                  "edges": []
                },
                {
                  "id": "alert_done",
                  "node_type": "static",
                  "static_message": {
                    "hi": "कृपया उन्हें अभी कॉल कीजिए। नमस्ते।",
                    "en": "Please call them now. Namaste.",
                    "bn": "দয়া করে এখনই ওনাকে ফোন করুন। নমস্কার।",
                    "mr": "कृपया आत्ताच त्यांना फोन करा. नमस्कार.",
                    "te": "దయచేసి ఇప్పుడే వారికి ఫోన్ చేయండి. నమస్తే.",
                    "ta": "தயவுசெய்து இப்போதே அவர்களை அழையுங்கள். வணக்கம்.",
                    "gu": "કૃપા કરીને હમણાં જ તેમને ફોન કરો. નમસ્તે.",
                    "kn": "ದಯವಿಟ್ಟು ಈಗಲೇ ಅವರಿಗೆ ಕರೆ ಮಾಡಿ. ನಮಸ್ಕಾರ.",
                    "ml": "ദയവായി ഇപ്പോൾ തന്നെ അവരെ വിളിക്കുക. നമസ്കാരം.",
                    "pa": "ਕਿਰਪਾ ਕਰਕੇ ਹੁਣੇ ਉਨ੍ਹਾਂ ਨੂੰ ਫ਼ੋਨ ਕਰੋ। ਸਤ ਸ੍ਰੀ ਅਕਾਲ।",
                    "od": "ଦୟାକରି ଏବେ ତାଙ୍କୁ ଫୋନ କରନ୍ତୁ। ନମସ୍କାର।",
                    "as": "অনুগ্ৰহ কৰি এতিয়াই তেওঁক ফোন কৰক। নমস্কাৰ।"
                  },
                  "function_call": "end_call",
                  "edges": []
                }
              ],
              "reasoning_effort": "none"
            }
          },
          "transcriber": {
            "provider": "sarvam",
            "model": "saaras:v4",
            "language": "hi",
            "stream": true,
            "endpointing": 700,
            "keywords": "CBI, TRAI, ED, police, digital arrest, Aadhaar, courier, customs, parcel, UPI, RTGS, OTP, hospital, accident",
            "context": "An older parent in India describes a suspicious phone call where someone claiming to be family, police or a bank asked for money or an OTP. Expect rupee amounts and family names."
          },
          "synthesizer": {
            "provider": "sarvam",
            "stream": true,
            "buffer_size": 150,
            "provider_config": {
              "model": "bulbul:v4-flash",
              "voice": "Aparna (Customer)",
              "voice_id": "aparna_hi_customer",
              "language": "hi",
              "speed": 1.0
            }
          },
