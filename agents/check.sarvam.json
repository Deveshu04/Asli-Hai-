{
  "agent_config": {
    "agent_name": "Asli hai? Family check (Sarvam)",
    "agent_type": "other",
    "agent_welcome_message": "{{greeting}}",
    "webhook_url": "https://YOUR-BACKEND/webhooks/bolna",
    "tasks": [
      {
        "task_type": "conversation",
        "toolchain": {
          "execution": "parallel",
          "pipelines": [
            [
              "transcriber",
              "llm",
              "synthesizer"
            ]
          ]
        },
        "task_config": {
          "hangup_after_LLMCall": false,
          "call_terminate": 240,
          "voicemail": true,
          "check_if_user_online": false,
          "incremental_delay": 1400,
          "number_of_words_for_interruption": 2
        },
        "tools_config": {
          "input": {
            "format": "wav",
            "provider": "plivo"
          },
          "output": {
            "format": "wav",
            "provider": "plivo"
          },
          "api_tools": {
            "tools": [
              {
                "key": "custom_task",
                "name": "report_verdict",
                "description": "Send the family member's answer to the safety line.",
                "parameters": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "did_call"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string"
                    },
                    "did_call": {
                      "type": "string"
                    },
                    "spoken_word": {
                      "type": "string"
                    }
                  }
                }
              }
            ],
            "tools_params": {
              "report_verdict": {
                "url": "https://YOUR-BACKEND/tools/report_verdict",
                "method": "POST",
                "param": {
                  "session_id": "%(session_id)s",
                  "did_call": "%(did_call)s",
                  "spoken_word": "%(spoken_word)s"
                },
                "headers": {
                  "Authorization": "Bearer YOUR_TOOL_SECRET",
                  "Content-Type": "application/json"
                },
                "scope": "node",
                "nodes": [
                  "report"
                ]
              }
            }
          },
          "llm_agent": {
            "agent_type": "graph_agent",
            "agent_flow_type": "streaming",
            "llm_config": {
              "provider": "openai",
              "model": "gpt-5.4-mini",
              "temperature": 1,
              "max_tokens": 120,
              "routing_model": "gpt-4.1-mini",
              "agent_information": "You are Saathi from the 'Asli hai?' safety line, calling {{child_name}} about their family member {{parent_name}}. Speak the language of the call, in its own script, one short sentence at a time. Never reveal the family word or {{parent_name}}'s number, and never say the family word yourself. Never ask for an OTP, PIN, password or account details, and never promise that money can be recovered. Never guess what happened to {{parent_name}}; say only what you were told. If someone other than {{child_name}} answers, ask them to have {{child_name}} call {{parent_name}} now.",
              "current_node_id": "ask_called",
              "nodes": [
                {
                  "id": "ask_called",
                  "prompt": "If {{mode}} is rescue, ask nothing: say in one short sentence that you are finding out what happened and ask them to stay on the line. If {{mode}} is alert, just ask them to call {{parent_name}} now. Otherwise get a clear yes or no: did they just call {{parent_name}} asking for money or help? Repeat the question once if they are confused.",
                  "repeat_after_silence_seconds": 8,
                  "edges": [
                    {
                      "to_node_id": "alert_done",
                      "condition_type": "expression",
                      "priority": 0,
                      "expression": {
                        "conditions": [
                          {
                            "variable": "recipient_data.mode",
                            "operator": "eq",
                            "value": "alert"
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "rescue_wait",
                      "condition_type": "expression",
                      "priority": 0,
                      "expression": {
                        "conditions": [
                          {
                            "variable": "recipient_data.mode",
                            "operator": "eq",
                            "value": "rescue"
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "tell",
                      "condition_type": "event",
                      "event_name": "rescue_update"
                    },
                    {
                      "to_node_id": "verify_live",
                      "condition_type": "event",
                      "event_name": "rescue_verify"
                    },
                    {
                      "to_node_id": "route_called",
                      "condition": "The person answered whether they called",
                      "parameters": {
                        "did_call": {
                          "type": "string",
                          "description": "Yes if they called the parent and asked for money or help. No if they did not. Unsure if unclear or someone else answered.",
                          "allowed_values": [
                            "Yes",
                            "No",
                            "Unsure"
                          ]
                        }
                      }
                    },
                    {
                      "to_node_id": "report",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_silence_repeats",
                            "operator": "gte",
                            "value": 2
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "id": "route_called",
                  "node_type": "router",
                  "edges": [
                    {
                      "to_node_id": "report",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "did_call",
                            "operator": "eq",
                            "value": "No"
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "ask_word",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "did_call",
                            "operator": "eq",
                            "value": "Yes"
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "report",
                      "condition_type": "unconditional"
                    }
                  ]
                },
                {
                  "id": "ask_word",
                  "prompt": "Ask them to say the family word. Never say or hint at the word yourself.",
                  "edges": [
                    {
                      "to_node_id": "report",
                      "condition": "They said a word or phrase, or said they don't know it",
                      "parameters": {
                        "spoken_word": "string"
                      }
                    }
                  ]
                },
                {
                  "id": "report",
                  "prompt": "Call @report_verdict with session_id {{session_id}}, did_call and spoken_word.",
                  "function_call": "report_verdict",
                  "edges": [
                    {
                      "to_node_id": "rescue_thanks",
                      "condition_type": "expression",
                      "priority": 0,
                      "expression": {
                        "conditions": [
                          {
                            "variable": "recipient_data.mode",
                            "operator": "eq",
                            "value": "rescue"
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "thanks",
                      "condition_type": "unconditional"
                    }
                  ]
                },
                {
                  "id": "thanks",
                  "node_type": "static",
                  "static_message": {
                    "hi": "शुक्रिया। मैं उन्हें अभी बता रही हूँ। नमस्ते।",
                    "en": "Thank you. I'm letting them know right now. Namaste.",
                    "bn": "ধন্যবাদ। আমি এখনই ওনাকে জানাচ্ছি। নমস্কার।",
                    "mr": "धन्यवाद. मी त्यांना आत्ताच सांगते. नमस्कार.",
                    "te": "ధన్యవాదాలు. నేను ఇప్పుడే వారికి చెబుతున్నాను. నమస్తే.",
                    "ta": "நன்றி. நான் இப்போதே அவர்களிடம் சொல்கிறேன். வணக்கம்.",
                    "gu": "આભાર. હું તેમને હમણાં જ જણાવું છું. નમસ્તે.",
                    "kn": "ಧನ್ಯವಾದಗಳು. ನಾನು ಈಗಲೇ ಅವರಿಗೆ ತಿಳಿಸುತ್ತಿದ್ದೇನೆ. ನಮಸ್ಕಾರ.",
                    "ml": "നന്ദി. ഞാൻ ഇപ്പോൾ തന്നെ അവരെ അറിയിക്കുന്നു. നമസ്കാരം.",
                    "pa": "ਧੰਨਵਾਦ। ਮੈਂ ਉਨ੍ਹਾਂ ਨੂੰ ਹੁਣੇ ਦੱਸ ਰਹੀ ਹਾਂ। ਸਤ ਸ੍ਰੀ ਅਕਾਲ।",
                    "od": "ଧନ୍ୟବାଦ। ମୁଁ ଏବେ ତାଙ୍କୁ ଜଣାଉଛି। ନମସ୍କାର।",
                    "as": "ধন্যবাদ। মই এতিয়াই তেওঁক জনাই আছোঁ। নমস্কাৰ।"
                  },
                  "function_call": "end_call",
                  "edges": []
                },
                {
                  "id": "rescue_wait",
                  "prompt": "You are keeping {{child_name}} on the line while Saathi finds out from {{parent_name}} what happened. Reply in one short, calm sentence: you are finding out right now and will tell them in a moment. Ask them to stay on the line and not to call {{parent_name}} yet, so that line stays free. Never guess what happened.",
                  "repeat_after_silence_seconds": 20,
                  "edges": [
                    {
                      "to_node_id": "tell",
                      "condition_type": "event",
                      "event_name": "rescue_update"
                    },
                    {
                      "to_node_id": "verify_live",
                      "condition_type": "event",
                      "event_name": "rescue_verify"
                    },
                    {
                      "to_node_id": "rescue_timeout",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_silence_repeats",
                            "operator": "gte",
                            "value": 5
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "rescue_timeout",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_node_turns",
                            "operator": "gte",
                            "value": 6
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "id": "verify_live",
                  "prompt": "Say this to {{child_name}}, word for word: {{verify_line}} Then get a clear yes or no. Repeat the question once if they are confused.",
                  "repeat_after_silence_seconds": 8,
                  "edges": [
                    {
                      "to_node_id": "route_called",
                      "condition": "The person answered whether they called",
                      "parameters": {
                        "did_call": {
                          "type": "string",
                          "description": "Yes if they called the parent and asked for money or help. No if they did not. Unsure if unclear or someone else answered.",
                          "allowed_values": [
                            "Yes",
                            "No",
                            "Unsure"
                          ]
                        }
                      }
                    },
                    {
                      "to_node_id": "report",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_silence_repeats",
                            "operator": "gte",
                            "value": 2
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "id": "tell",
                  "prompt": "Tell {{child_name}} this, word for word: {{update}} If they ask something, answer only from that, in one short sentence.",
                  "repeat_after_silence_seconds": 8,
                  "edges": [
                    {
                      "to_node_id": "alert_done",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_silence_repeats",
                            "operator": "gte",
                            "value": 1
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "alert_done",
                      "condition_type": "expression",
                      "expression": {
                        "conditions": [
                          {
                            "variable": "_node_turns",
                            "operator": "gte",
                            "value": 2
                          }
                        ]
                      }
                    },
                    {
                      "to_node_id": "alert_done",
                      "condition": "They acknowledged, said okay, or said they will call"
                    }
                  ]
                },
                {
                  "id": "rescue_timeout",
                  "node_type": "static",
                  "static_message": {
                    "hi": "मुझे अभी पूरी बात पता नहीं चल पाई। कृपया अभी ख़ुद उन्हें कॉल कीजिए। नमस्ते।",
                    "en": "I couldn't get the full story yet. Please call them yourself now. Namaste.",
                    "bn": "আমি এখনও পুরো ব্যাপারটা জানতে পারিনি। দয়া করে এখনই নিজে ওনাকে ফোন করুন। নমস্কার।",
                    "mr": "मला अजून पूर्ण माहिती मिळाली नाही. कृपया आत्ताच स्वतः त्यांना फोन करा. नमस्कार.",
                    "te": "నాకు ఇంకా పూర్తి విషయం తెలియలేదు. దయచేసి ఇప్పుడే మీరే వారికి ఫోన్ చేయండి. నమస్తే.",
                    "ta": "எனக்கு இன்னும் முழு விவரம் தெரியவில்லை. தயவுசெய்து இப்போதே நீங்களே அவர்களை அழையுங்கள். வணக்கம்.",
                    "gu": "મને હજી પૂરી વાત ખબર નથી પડી. કૃપા કરીને હમણાં જ જાતે તેમને ફોન કરો. નમસ્તે.",
                    "kn": "ನನಗೆ ಇನ್ನೂ ಪೂರ್ತಿ ವಿಷಯ ತಿಳಿದಿಲ್ಲ. ದಯವಿಟ್ಟು ಈಗಲೇ ನೀವೇ ಅವರಿಗೆ ಕರೆ ಮಾಡಿ. ನಮಸ್ಕಾರ.",
                    "ml": "എനിക്ക് ഇതുവരെ മുഴുവൻ കാര്യവും അറിയാൻ കഴിഞ്ഞില്ല. ദയവായി ഇപ്പോൾ തന്നെ നിങ്ങൾ അവരെ വിളിക്കുക. നമസ്കാരം.",
                    "pa": "ਮੈਨੂੰ ਹਾਲੇ ਪੂਰੀ ਗੱਲ ਪਤਾ ਨਹੀਂ ਲੱਗੀ। ਕਿਰਪਾ ਕਰਕੇ ਹੁਣੇ ਆਪ ਉਨ੍ਹਾਂ ਨੂੰ ਫ਼ੋਨ ਕਰੋ। ਸਤ ਸ੍ਰੀ ਅਕਾਲ।",
                    "od": "ମୁଁ ଏଯାଏଁ ପୂରା କଥା ଜାଣିପାରିନି। ଦୟାକରି ଏବେ ନିଜେ ତାଙ୍କୁ ଫୋନ କରନ୍ତୁ। ନମସ୍କାର।",
